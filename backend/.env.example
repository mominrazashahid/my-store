# Copy to .env and adjust
PORT=4000

# Local MongoDB (standalone for now; we switch to ?replicaSet=rs0 at checkout phase)
MONGODB_URI=mongodb://127.0.0.1:27017/my_store

# Secret for signing store-owner JWTs (change this)
JWT_SECRET=dev_change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Where the Next.js frontend runs (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Free plan product cap
FREE_PLAN_PRODUCT_LIMIT=20
